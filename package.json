{
  "name": "@eav93/vue3-treeselect",
  "version": "0.7.0",
  "description": "Tree select component with nested options for Vue 3.5+ (TypeScript). A fork of vue-treeselect with fixes and performance improvements for large trees.",
  "main": "./dist/vue3-treeselect.js",
  "module": "./dist/vue3-treeselect.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-treeselect.mjs",
      "require": "./dist/vue3-treeselect.js"
    },
    "./locales/*": {
      "types": "./dist/types/locales/*.d.ts",
      "import": "./dist/locales/*.mjs",
      "require": "./dist/locales/*.cjs"
    },
    "./*": "./*"
  },
  "unpkg": "./dist/vue3-treeselect.umd.js",
  "style": "./dist/vue3-treeselect.css",
  "sass": "./sass/style.scss",
  "files": [
    "sass",
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "megafetis",
  "license": "MIT",
  "homepage": "https://github.com/eav93/vue3-treeselect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eav93/vue3-treeselect.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "next",
    "vue next",
    "tree",
    "treeselect",
    "select",
    "tree select",
    "hierarchy",
    "hierarchical",
    "vue-treeselect",
    "typescript",
    "multiselect"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode locales",
    "type-check": "vue-tsc --noEmit",
    "prepublishOnly": "npm run type-check && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config bench/vitest.config.mts",
    "bench:browser": "node bench/browser/run.mjs"
  },
  "dependencies": {
    "material-colors": "^1.2.6",
    "sass-easing": "^1.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "fuzzysearch": "1.0.3",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "browserslist": [
    "Android >= 6.0",
    "iOS >= 9",
    "not dead"
  ],
  "contributors": [
    "Riophae Lee",
    "megafetis",
    "eav93"
  ],
  "bugs": {
    "url": "https://github.com/eav93/vue3-treeselect/issues"
  }
}
